# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/

# production
/build

# misc — OS junk
.DS_Store
Thumbs.db
ehthumbs.db
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Secrets never leave this machine. .env.example is the tracked template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# Generated by Next.js on every dev/build; contents are an implementation
# detail and must not be tracked (see Next.js docs, config/typescript).
next-env.d.ts

# python — scripts/render-icons.py
__pycache__/
*.py[cod]
.venv/
venv/

# editors
.idea/
.vscode/

# Claude Code: launch.json is shared (dev-server config); local machine
# settings and session state are not.
.claude/settings.local.json
.claude/*.local.json

# Local-only working folders. Not part of the app — the build passes without
# them — and deliberately never published:
#   gereksiz/         finished design intermediates (briefs, raw tool exports)
#   Proje Yardımcısı/ portable AI-assistant context, personal notes
/gereksiz/
/Proje Yardımcısı/

# --- Supabase (bulut veritabanı) ---
# Supabase panelinden: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
#  AI model zinciri
#
#  Her istek şu sırayla denenir; bir model cevap veremezse (kota, yetki,
#  bulunamayan model, ağ, şemaya uymayan çıktı) sıradakine geçilir:
#
#    1. gemini-3.5-flash               (Google)
#    2. gemini-3.1-flash-lite-preview  (Google)
#    3. gpt-5-mini                     (OpenAI)
#    4. gemini-3-flash-preview         (Google)
#    5. gemini-2.5-flash               (Google)
#
#  Anahtarı olmayan sağlayıcının modelleri zincirden düşer, yani tek anahtarla
#  da çalışır. Anahtarlar SADECE sunucuda okunur, tarayıcıya düşmez.
# ============================================================

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Zinciri tamamen değiştirmek istersen (opsiyonel) ---
# Virgülle ayrılmış model listesi; sağlayıcı model adından anlaşılır.
# AI_MODEL_CHAIN=gemini-3.5-flash,gpt-5-mini,gemini-2.5-flash

# --- Düşünme bütçesi (opsiyonel) ---
# OpenAI (gpt-5 / o-serisi): none | minimal | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=low
# Gemini 3 ve sonrası: minimal | low | medium | high
# (gemini-2.5-* bu parametreyi tanımaz, kendi dinamik varsayılanıyla çalışır)
GEMINI_THINKING_LEVEL=medium
